classDiagram
direction TB

%% DUNGEONFORGE - design-pattern-oriented UML
%% Pattern groups are marked by section comments for IntelliJ compatibility.
%% Solid hollow triangle = inheritance; dashed hollow triangle = implements.
%% Diamond = contains; plain arrow = uses / creates.

%% ===== SINGLETON =====
class GameConfig {
  <<Singleton>>
  -static instance : GameConfig
  -GameConfig()
  +static getInstance() GameConfig
  +getInt(key) int
  +getDouble(key) double
  +static resetForTests()
}
class RandomSource {
  <<Singleton>>
  -static instance : RandomSource
  -RandomSource()
  +static getInstance() RandomSource
  +reseed(seed)
  +nextInt(bound) int
}

%% ===== SIMPLEFACTORY =====
class MonsterFactory {
  <<Simple Factory>>
  +create(id, depth) Monster
}
class MonsterDef

%% ===== FACTORYMETHOD =====
class RoomPopulator {
  <<abstract creator>>
  #theme : ThemeKit
  +populate(room, depth) void
  #createEncounter(depth) List~Monster~
  #createChest(depth) Chest
}
class StandardRoomPopulator
class BossRoomPopulator
class TreasureRoomPopulator

%% ===== ABSTRACTFACTORY =====
class ThemeKit {
  <<interface>>
  +themeName() String
  +createMonster(depth) Monster
  +createBoss(depth) Monster
  +createLoot(depth) Item
  +createRoomFlavor() String
}
class CryptThemeKit
class ForgeThemeKit
class FrostThemeKit
class WinterfellThemeKit
class ThemeRegistry {
  -kits : List~ThemeKit~
  +forDepth(depth) ThemeKit
}

%% ===== STRATEGY =====
class CombatStrategy {
  <<interface>>
  +chooseAction(self, target, room) Action
  +name() String
}
class AggressiveStrategy
class RangedStrategy
class HealerStrategy
class SkittishStrategy
class RedCoatStrategy
class Action {
  +type : Type
  +target : Entity
}

%% ===== OBSERVER =====
class EventBus {
  <<subject / publisher>>
  -listeners : List~GameEventListener~
  +subscribe(listener)
  +unsubscribe(listener)
  +publish(event)
}
class GameEventListener {
  <<interface / observer>>
  +onEvent(event)
}
class GameEvent
class EventType
class QuestTracker
class AchievementSystem
class CombatLog
class DamageMeter
class DangerMeter

%% ===== COMMAND =====
class Command {
  <<interface>>
  +execute()
  +undo()
  +getDescription() String
  +isUndoable() boolean
  +endsTurn() boolean
}
class AbstractCommand {
  <<abstract / Template Method>>
  #ctx : GameContext
  +execute() void
  #doExecute() boolean
  +undo() void
}
class AttackCommand
class MoveCommand
class TakeCommand
class DropCommand
class UseItemCommand
class EquipCommand
class EnchantCommand
class SimpleCommand
class NoCommand {
  <<Null Object>>
}
class MacroCommand {
  <<Macro Command>>
  -children : List~Command~
  +execute() void
  +undo() void
}
class CommandParser {
  <<invoker / registry>>
  -registry : Map~String,CommandFactory~
  +parse(input, ctx) Command
}
class CommandFactory {
  <<interface / functional>>
  +create(ctx, args) Command
}
class CommandHistory {
  -undoStack : Deque~Command~
  +push(command)
  +undoLast() boolean
}
class TurnSnapshot {
  <<Memento>>
  +static capture(player, room) TurnSnapshot
  +restore()
}

%% ===== GAMESTATEPATTERN =====
class GameState {
  <<interface / State>>
  +onEnter(ctx)
  +onExit(ctx)
  +availableCommands() List~String~
  +name() String
}
class ExploringState
class CombatState
class InventoryState
class GameOverState

%% ===== MONSTERSTATEPATTERN =====
class MonsterState {
  <<interface / State>>
  +onEnter(self)
  +canAct() boolean
  +damageMultiplier() double
  +next(self, player) MonsterState
  +label() String
}
class IdleState
class HuntingState
class EnragedState
class FleeingState
class DeadState

%% ===== DECORATOR =====
class Item {
  <<interface>>
  +getName() String
  +describe() String
}
class Weapon {
  <<interface / component>>
  +getDamage() int
  +lifesteal() int
}
class BasicWeapon {
  <<concrete component>>
}
class WeaponDecorator {
  <<abstract decorator>>
  #wrapped : Weapon
  +getDamage() int
  +unwrap() Weapon
}
class FlamingWeapon
class FrostWeapon
class VampiricWeapon
class KeenWeapon
class EnchantmentRegistry {
  <<decorator registry>>
  +static apply(enchantment, weapon) Weapon
  +static known() List~String~
}

%% ===== COREANDSUPPORT =====
class Main {
  +main(args)
}
class GameContext {
  <<Command receiver / game State context>>
  -state : GameState
  +transitionTo(next)
  +syncState()
  +allowedVerbs() List~String~
  +runMonsterTurns()
}
class GameWorld
class DungeonLevel
class Room
class Combat
class Entity {
  <<abstract>>
}
class Monster {
  -strategy : CombatStrategy
  -stateName : MonsterState
  +setStrategy(strategy)
  +setState(state)
}
class Player
class Chest
class Armor
class Potion
class Hourglass
class Treasure
class Quest

%% SINGLETON
RandomSource ..> GameConfig : reads seed

%% FACTORIES
MonsterFactory --> MonsterDef : reads definitions
MonsterFactory ..> Monster : constructs
RoomPopulator <|-- StandardRoomPopulator
RoomPopulator <|-- BossRoomPopulator
RoomPopulator <|-- TreasureRoomPopulator
RoomPopulator o-- ThemeKit : uses
ThemeKit <|.. CryptThemeKit
ThemeKit <|.. ForgeThemeKit
ThemeKit <|.. FrostThemeKit
ThemeKit <|.. WinterfellThemeKit
ThemeRegistry o-- ThemeKit : registered kits
CryptThemeKit ..> MonsterFactory : creates via
ForgeThemeKit ..> MonsterFactory : creates via
FrostThemeKit ..> MonsterFactory : creates via
WinterfellThemeKit ..> MonsterFactory : creates via
GameWorld ..> RoomPopulator : populates rooms
GameWorld --> ThemeRegistry : selects theme

%% STRATEGY
CombatStrategy <|.. AggressiveStrategy
CombatStrategy <|.. RangedStrategy
CombatStrategy <|.. HealerStrategy
CombatStrategy <|.. SkittishStrategy
CombatStrategy <|.. RedCoatStrategy
Monster o-- CombatStrategy : interchangeable behavior
CombatStrategy ..> Action : returns decision
Combat ..> CombatStrategy : invokes

%% OBSERVER
EventBus o-- GameEventListener : notifies
GameEventListener <|.. QuestTracker
GameEventListener <|.. AchievementSystem
GameEventListener <|.. CombatLog
GameEventListener <|.. DamageMeter
GameEventListener <|.. DangerMeter
EventBus ..> GameEvent : publishes
GameEvent --> EventType : has type
Combat --> EventBus : publishes

%% COMMAND / TEMPLATE METHOD / NULL OBJECT / MEMENTO
Command <|.. AbstractCommand
Command <|.. MacroCommand
Command <|.. NoCommand
Command <|.. SimpleCommand
AbstractCommand <|-- AttackCommand
AbstractCommand <|-- MoveCommand
AbstractCommand <|-- TakeCommand
AbstractCommand <|-- DropCommand
AbstractCommand <|-- UseItemCommand
AbstractCommand <|-- EquipCommand
AbstractCommand <|-- EnchantCommand
AbstractCommand *-- GameContext : receiver
AbstractCommand o-- TurnSnapshot : before-state
MacroCommand *-- Command : children
CommandParser --> CommandFactory : registry
CommandFactory ..> Command : creates
CommandParser ..> Command : returns
CommandHistory o-- Command : undo stack
GameContext --> CommandHistory : owns history
GameContext --> Combat : runs turns
Main --> CommandParser : parses input
Main --> Command : executes

%% STATE - game mode and monster lifecycle are distinct contexts
GameState <|.. ExploringState
GameState <|.. CombatState
GameState <|.. InventoryState
GameState <|.. GameOverState
GameContext o-- GameState : current mode
MonsterState <|.. IdleState
MonsterState <|.. HuntingState
MonsterState <|.. EnragedState
MonsterState <|.. FleeingState
MonsterState <|.. DeadState
Monster o-- MonsterState : lifecycle
Combat ..> MonsterState : checks / advances

%% DECORATOR
Item <|-- Weapon
Weapon <|.. BasicWeapon
Weapon <|.. WeaponDecorator
WeaponDecorator o-- Weapon : wraps
WeaponDecorator <|-- FlamingWeapon
WeaponDecorator <|-- FrostWeapon
WeaponDecorator <|-- VampiricWeapon
WeaponDecorator <|-- KeenWeapon
EnchantmentRegistry ..> WeaponDecorator : constructs decorators
EnchantCommand --> EnchantmentRegistry : applies

%% CORE RELATIONSHIPS
Entity <|-- Monster
Entity <|-- Player
GameWorld *-- DungeonLevel
DungeonLevel *-- Room
Room o-- Monster
Room o-- Chest
Player o-- Item : inventory
Player --> Weapon : equipped
Item <|.. Armor
Item <|.. Potion
Item <|.. Hourglass
Item <|.. Treasure
QuestTracker o-- Quest
Main --> GameContext : initializes
